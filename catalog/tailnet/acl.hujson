// ⚠️ THIS FILE IS NOT WHAT GETS APPLIED, and it has drifted.  The policy the
// fleet actually runs is GENERATED — `tailnetAclCanonical` in
// modules/.common.d/manage-tailnet.d/default.nix, written to
// `tailnet-acl-canonical.json` and reconciled into the live tailnet by
// `manage-tailnet --sync-acl`.  That generated canonical derives its CIDRs from
// the catalog (each baremetal's advertiseCidr, the home LAN, the vmnet supernet),
// which this hand-written copy never had; it also lacks the `autogroup:members`
// rule and the `tag:k8s` rule.  Read it for the VOCABULARY and the RATIONALE
// below — the two-axis tag design and the SSH `accept`-over-`check` decision,
// which live nowhere else — and read default.nix for what is in force.
//
// Keeping two copies is the reason they disagree; this one should either be
// deleted (moving the rationale into default.nix) or generated.  Not yet decided.
//
// Tailnet ACL policy — declarative source of truth for tailnet access
// and Tailscale SSH edges.  Controller-AGNOSTIC: the same HuJSON file
// applies to whichever control-plane is live.
//
// Apply with, depending on the controller:
//
//     headscale : headscale policy set -f /path/to/this/file
//     SaaS      : POST /api/v2/tailnet/-/acl   (or paste in the admin console)
//
// The file is in HuJSON: JSON + comments + trailing commas.  Both
// Headscale and Tailscale SaaS parse it directly.
//
// Two orthogonal tag axes — a node normally advertises one from each:
//
//   Role axis (does a human sit at this host's console?):
//     tag:console  — console-attached, human-driven.  Laptops,
//                    workstations, admin terminals.  Originates admin
//                    SSH; reaches any other node.
//     tag:headless — no local console; reachable only remotely.
//                    Servers, VMs, containers, cluster nodes.  Accepts
//                    SSH; does not originate admin SSH.
//
//   Kind axis (what the node is):
//     tag:darwin    — macOS hosts (bioskop, nikopol)
//     tag:nixos     — NixOS guest VMs (bioskop-nixos, nikopol-nixos)
//
//   And one tag that is NOT ours:
//     tag:k8s       — every device the Tailscale operator registers inside a
//                     cluster (funnel / ingress proxies). It is the operator
//                     CHART's own `proxyConfig.defaultTags` default, claimed by
//                     the operator's OAuth client — so it is deliberately absent
//                     from `tagOwners` below and from catalog/tailnet/tags.kind.
//                     Claiming it here would hand ownership to our rotation key
//                     and stop the operator registering anything at all.
//                     It carries NO role-axis tag, so the two role rules below
//                     cannot cover it; the third rule names it explicitly.
//                     (`tag:incus` and `tag:rke2` were removed 2026-09-27 — no
//                     device ever carried either, and `rke2` was the headscale-era
//                     name for what the operator calls `k8s`.)
//
// Broad policy rules key off the role axis (compact, grep-able).
// Kind-specific rules (e.g. "only rke2 nodes reach the cluster API
// port") can be layered on top once such a rule is actually needed.
//
// All tags are owned by `group:ndh`; only that group's members (and,
// on SaaS, an OAuth client granted those tags) may register a node that
// claims any of these tags.  Advertising happens via the auth key's tag
// list — headscale v2 binds tags to the preauth key, and the SaaS
// per-kind keys minted by scripts/manage-tailnet carry the same
// pair — not via a client-asserted --advertise-tags.
{
  // Headscale policy v2 (default since 0.26) has TWO distinct
  // username conventions, depending on the field:
  //
  //   - Fields that hold tailnet identities (`groups.<name>`,
  //     `tagOwners.<tag>`, `acls.src`, `acls.dst`) use the
  //     `<localpart>@` form — the `@` disambiguates non-OIDC local
  //     accounts from full email identifiers.  E.g. `nxmatic@`.
  //
  //   - The `ssh.users` field holds **literal Unix usernames** on
  //     the SSH destination, NOT tailnet identities.  Plain names
  //     here, no `@` suffix.  E.g. `nxmatic`, `root`.  Confirmed
  //     by upstream test cases (hscontrol/policy/v2/filter_test.go
  //     line 487+ uses `"ubuntu", "admin", "deploy"`).
  "groups": {
    "group:ndh": [
      "nxmatic@",
    ],
  },

  "tagOwners": {
    "tag:console":  ["group:ndh"],
    "tag:headless": ["group:ndh"],
    "tag:darwin":   ["group:ndh"],
    "tag:nixos":    ["group:ndh"],
  },

  // Tailnet reachability authored on the role axis.
  //
  //   console  → console | headless | k8s   any port
  //   headless → headless                   any port
  //   headless → console                    implicit deny
  //
  // ⚠️ A tag in `dst` covers only the node's OWN tailnet addresses. A SUBNET
  // ROUTE needs its CIDR named in `dst` too — "a tag'd node's netmap only carries
  // a subnet route it is ACL-permitted to reach". That is why the applied policy
  // carries the per-baremetal /20s, the home LAN /24 and the vmnet /18 beside the
  // tags. They are absent here because this file predates them and is not the
  // artifact that gets applied (see the header).
  "acls": [
    {
      "action": "accept",
      "src":    ["tag:console"],
      "dst":    ["tag:console:*", "tag:headless:*"],
    },
    {
      "action": "accept",
      "src":    ["tag:headless"],
      "dst":    ["tag:headless:*"],
    },
    // The operator's own devices. They carry `tag:k8s` and NO role-axis tag, so
    // neither rule above reaches them: today a funnel proxy answers the public
    // internet through Funnel while being unreachable from this tailnet, which
    // is not a posture anyone chose. Named explicitly rather than fixed by making
    // the operator stamp a role tag too — the tag is not ours to shape, and a
    // `dst` may reference a tag without owning it.
    {
      "action": "accept",
      "src":    ["tag:console"],
      "dst":    ["tag:k8s:*"],
    },
  ],

  // Tailscale SSH.  Two rules:
  //
  //   1. Console nodes SSH into any node — interactive + scripted —
  //      with `accept` (no per-session re-auth prompt).  Trades the
  //      stolen-device-key defence (`check`/12h re-auth would
  //      mitigate) for friction-free `nix copy --to`, automation
  //      scripts that can't answer interactive prompts, and a
  //      consistent ssh-client UX with the rest of the fleet.  On a
  //      single-operator fleet the missed defence isn't load-bearing;
  //      reconsider if the operator set ever grows.
  //
  //   2. Headless nodes SSH each other freely.  They can't answer
  //      interactive prompts in any case; identities are verified by
  //      the tailnet itself (node key), so auto-accept is safe.
  //      Covers nix-store copies between VMs, rke2 node-to-node
  //      operations, etc.
  //
  // Headless nodes never SSH console nodes (no rule → implicit deny).
  "ssh": [
    {
      "action": "accept",
      "src":    ["tag:console"],
      "dst":    ["tag:console", "tag:headless"],
      "users":  ["nxmatic", "root"],
    },
    {
      "action": "accept",
      "src":    ["tag:headless"],
      "dst":    ["tag:headless"],
      "users":  ["nxmatic", "root"],
    },
  ],
}
