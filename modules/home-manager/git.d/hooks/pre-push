#!/usr/bin/env bash
# Dispatcher / catch-all backstop: refuse to push a protected branch when the
# pushed tree carries a wip/.wip path — the only path that catches a fast-forward
# merge (which creates no commit, so pre-commit never sees it) — and refuse to
# publish, on any ref, a commit that is not signed by a trusted key. Then chain to
# the repo's own pre-push, replaying the same stdin.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-wip-guard.sh
. "${here}/lib-wip-guard.sh"
# shellcheck source=lib-signing-guard.sh
. "${here}/lib-signing-guard.sh"

zero="0000000000000000000000000000000000000000"
input="$(cat)"
status=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue
  unsigned="$(unsigned_commits_in "${local_sha}" "${remote_sha}")"
  if [ -n "${unsigned}" ]; then
    reject_unsigned "${unsigned}" "${remote_ref}"
    status=1
  fi
  case "${remote_ref}" in
    refs/heads/*) branch="${remote_ref#refs/heads/}" ;;
    *) continue ;;
  esac
  is_protected_branch "${branch}" || continue
  [ "${local_sha}" = "${zero}" ] && continue
  paths="$(wip_paths_in "${local_sha}")"
  if [ -n "${paths}" ]; then
    reject "${paths}" "${branch}"
    status=1
  fi
done <<< "${input}"

if [ "${status}" -ne 0 ]; then
  exit "${status}"
fi

chain_repo_local pre-push "${here}" "$@" <<< "${input}"
