#!/usr/bin/env bash
# Dispatcher: block committing a wip/.wip path onto a protected branch (catches
# direct commits and squash-merges, which both stage onto main/develop). Then chain
# to the repo's own pre-commit so a global core.hooksPath does not shadow it. Every step is traced with its
# time (bash's own clock: a fork per line made a 3000-file commit take minutes), so the operator sees what
# runs and what waits (the operator, 2026-10-28).
export PS4='+ ${EPOCHREALTIME%.*} ${BASH_SOURCE##*/}:${LINENO}: '
set -euxo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-wip-guard.sh
. "${here}/lib-wip-guard.sh"

# shellcheck source=lib-sops-filter-guard.sh
. "${here}/lib-sops-filter-guard.sh"

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
if is_protected_branch "${branch}"; then
  paths="$(wip_paths_in_index)"
  if [ -n "${paths}" ]; then
    reject "${paths}" "${branch}"
    exit 1
  fi
fi

if repo_holds_flake; then
  hits="$(sops_filtered_paths_any)"
  if [ -n "${hits}" ]; then
    {
      echo "⛔ sops-filter-guard: this repository holds a flake, and these files resolve to a sops filter:"
      head -20 <<<"${hits}" | sed 's/^/   /'
      echo "Remove the filter= attribute (a .gitattributes, .git/info/attributes or the global attributes"
      echo "file): a flake repository keeps its sops files encrypted on disk."
    } >&2
    exit 1
  fi
fi

chain_repo_local pre-commit "${here}" "$@"
