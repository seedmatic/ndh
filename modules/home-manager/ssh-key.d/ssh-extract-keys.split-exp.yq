# v2 ssh-extract-keys split expression.
#
# Input: enriched v2 yaml with top-level `authorities:` + `keys:`. Each key
# may carry `certificates.<authority>.<ssh-user|ssh-host>` cert lines added
# by the enrichment step.
#
# Output: a stream of yaml docs (split via `yq -s`), one per file to write.
# Each doc carries:
#   rel_path    — file name relative to the chosen target_dir
#   target_dir  — one of "user" / "system" / "system-private"
#   content     — the file payload
#   yamlfile    — staging path under $TMPDIR (caller consumes this)
#
# Scope routing:
#   * Authority public keys                → system (shared, root-readable)
#   * Key private (profiles ∋ system)      → system-private (root-owned)
#   * Key private (otherwise)              → user
#   * Key public                           → user
#   * Key certificates                     → system
#
# Implementation note: yq-go re-enters the pipeline from the root for each
# top-level expression separated by `,`. To keep `$tmpdir` and per-key
# variables in scope across all emitted docs, we build a single list-valued
# expression per iteration and flatten with `.[]` at the end.

env(TMPDIR) + "/" as $tmpdir |

# ── 1. Authority public keys (one per authority) ─────────────────────────────
( ( .authorities // {} ) | to_entries | map(
    .key as $authName |
    .value.type as $authType |
    .value.public as $authPub |
    .value.comment as $authComment |
    select($authPub != null and $authPub != "") |
    {
      "yamlfile":   ( $tmpdir + $authName + "-ca.yaml" ),
      "rel_path":   ( $authName + "-ca.pub" ),
      "target_dir": "system",
      "content":    ( [ $authType, $authPub, ($authComment // $authName) ] | join(" ") )
    }
  )
) as $authArtifacts |

# ── 2. Per-key artifacts (private + pub + certs) ─────────────────────────────
( ( .keys // {} ) | to_entries | map(
    .key as $basename |
    .value.profiles // [] as $profiles |
    .value.type as $keyType |
    .value.public as $public |
    .value.private as $private |
    .value.comment as $keyComment |
    .value.certificates as $certs |

    # Private scope: system-private if profile includes "system".
    ( { "scope": "user" } | with(
        select( [ "system" ] - $profiles | length == 0 );
        .scope = "system-private"
      ) | .scope ) as $private_scope |

    # Build a list of docs for this key. Each element may be null; filter later.
    [
      (
        { "yamlfile":   ( $tmpdir + $basename + ".yaml" ),
          "rel_path":   $basename,
          "target_dir": $private_scope,
          "content":    $private }
      ),
      (
        { "yamlfile":   ( $tmpdir + $basename + "-public.yaml" ),
          "rel_path":   ( $basename + ".pub" ),
          "target_dir": "user",
          "content":    (
            $public | with( select(test("^ssh-") | not); . = [ $keyType, ., ($keyComment // $basename) ] | join(" ") )
          ) }
      )
    ]
    +
    (
      ( $certs // {} ) | to_entries | map(
        .key as $authName |
        .value as $certsByUsage |
        [
          ( { "yamlfile":   ( $tmpdir + $basename + "-" + $authName + "-host-cert.yaml" ),
              "rel_path":   ( $basename + "-" + $authName + "-host-cert.pub" ),
              "target_dir": "system",
              "content":    ( $certsByUsage."ssh-host" // null ) } ),
          ( { "yamlfile":   ( $tmpdir + $basename + "-" + $authName + "-user-cert.yaml" ),
              "rel_path":   ( $basename + "-" + $authName + "-user-cert.pub" ),
              "target_dir": "system",
              "content":    ( $certsByUsage."ssh-user" // null ) } )
        ]
      ) | flatten
    )
  ) | flatten
) as $keyArtifacts |

# Merge + emit. split_doc consumes each element as a separate yaml doc.
$authArtifacts + $keyArtifacts
| .[]
| select(.content != null and .content != "")
| split_doc
