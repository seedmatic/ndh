# v2 ssh-extract-keys split expression.
#
# Input: enriched v2 yaml with top-level `authorities:` + `keys:`. Each key
# may carry `certificates.<authority>.<ssh-user|ssh-host>` cert lines added
# by the enrichment step.
#
# Output: a stream of yaml docs (split via `yq -s`), one per file to write.
# Each doc carries:
#   rel_path    — file name relative to the chosen target_dir
#   target_dir  — one of "user" / "system" / "system-private"
#   content     — the file payload
#   yamlfile    — staging path under $TMPDIR (caller consumes this)
#
# Scope routing:
#   * Authority public keys                → system (shared, root-readable)
#   * Key private (profiles ∋ system)      → system-private (root-owned)
#   * Key private (otherwise)              → user
#   * Key public                           → user
#   * Key certificates                     → system
#
# Implementation note: yq-go re-enters the pipeline from the root for each
# top-level expression separated by `,`. To keep `$tmpdir` and per-key
# variables in scope across all emitted docs, we build a single list-valued
# expression per iteration and flatten with `.[]` at the end.

env(TMPDIR) + "/" as $tmpdir |

# ── 1. Authority public keys (one per authority GENERATION) ──────────────────
# Every slot is materialised, because every generation is ACCEPTED while only the
# newest is PRESENTED (docs/ssh-keys-renewal-spec.adoc). The presented generation
# keeps the canonical name and the others take a `-<slot>` segment, so a settled
# entry — one slot — produces exactly the file set it produced before slots
# existed, and the extra files appear only while a renewal is in flight.
#
# Authorities need the overlap most: both aggregators that build
# trusted-user-ca.pub glob `*-ca.pub`, so a second generation joins the trust set
# with no change on either platform.
( ( .authorities // {} ) | to_entries | map(
    .key as $authName |
    .value.type as $authType |
    .value.comment as $authComment |
    ( ( .value.slots // {} ) | to_entries | sort_by(.key) ) as $slots |
    ( $slots | .[-1].key ) as $presented |
    ( $slots | map(
        # yq-go has no `if/then/else` — that is jq. `with(select(cond); update)`
        # is the conditional here, which is why the record is built first and
        # then adjusted. An empty `public` stays empty and the trailing select
        # drops the artefact.
        { "slot": .key, "line": ( .value.public // "" ), "stem": $authName }
        | with(select(.slot != $presented); .stem = $authName + "-" + .slot)
        | with(select(.line != "");         .line = ( [ $authType, .line, ($authComment // $authName) ] | join(" ") ))
        | .stem as $stem | .line as $line |
        {
          "yamlfile":   ( $tmpdir + $stem + "-ca.yaml" ),
          "rel_path":   ( $stem + "-ca.pub" ),
          "target_dir": "system",
          "content":    $line
        }
      ) )
  ) | flatten
) as $authArtifacts |

# ── 2. Per-key artifacts (private + pub per GENERATION, plus certs) ──────────
( ( .keys // {} ) | to_entries | map(
    .key as $basename |
    .value.type as $keyType |
    .value.comment as $keyComment |
    ( ( .value.slots // {} ) | to_entries | sort_by(.key) ) as $slots |
    ( $slots | .[-1].key ) as $presented |

    # The yaml passed to this split expression is already filtered by profile
    # (system extraction gets system-profile keys, user extraction gets user-profile keys).
    # Always emit private key - the extraction script's context determines the target directory.
    #
    # One private, one public and its certificates per generation. ssh offers
    # identities in turn and sshd takes N HostKey directives, so materialising the
    # retiring generation alongside the new one is what carries a renewal across
    # hosts that have not activated yet — and a certificate belongs to the
    # generation it certifies, which is why it lives inside the slot.
    ( $slots | map(
        # `public` is the bare base64 blob; the line consumers accept is rebuilt
        # from type + blob + comment. See the authorities block above for why the
        # record is built and then adjusted with `with` rather than a ternary.
        { "slot":    .key,
          "line":    ( .value.public // "" ),
          "private": ( .value.private // "" ),
          "certs":   ( .value.certificates // {} ),
          "stem":    $basename }
        | with(select(.slot != $presented); .stem = $basename + "-" + .slot)
        | with(select(.line != "");         .line = ( [ $keyType, .line, ($keyComment // $basename) ] | join(" ") ))
        | .stem as $stem | .line as $line | .private as $private | .certs as $certs |
        [
          { "yamlfile":   ( $tmpdir + $stem + ".yaml" ),
            "rel_path":   $stem,
            "target_dir": "system-private",
            "content":    $private },
          { "yamlfile":   ( $tmpdir + $stem + "-public.yaml" ),
            "rel_path":   ( $stem + ".pub" ),
            "target_dir": "user",
            "content":    $line }
        ]
        +
        ( $certs | to_entries | map(
            .key as $authName |
            .value as $certsByUsage |
            [
              { "yamlfile":   ( $tmpdir + $stem + "-" + $authName + "-host-cert.yaml" ),
                "rel_path":   ( $stem + "-" + $authName + "-host-cert.pub" ),
                "target_dir": "system",
                "content":    ( $certsByUsage."ssh-host" // null ) },
              { "yamlfile":   ( $tmpdir + $stem + "-" + $authName + "-user-cert.yaml" ),
                "rel_path":   ( $stem + "-" + $authName + "-user-cert.pub" ),
                "target_dir": "system",
                "content":    ( $certsByUsage."ssh-user" // null ) },
              # TLS x509 leaf cert — PEM blob, drops next to the private
              # key with a `.crt` suffix so consumers (headscale daemon)
              # can pass a single basename pair.
              { "yamlfile":   ( $tmpdir + $stem + "-" + $authName + "-tls.yaml" ),
                "rel_path":   ( $stem + ".crt" ),
                "target_dir": "system",
                "content":    ( $certsByUsage."tls-server" // null ) }
            ]
          ) | flatten )
      ) | flatten )
  ) | flatten
) as $keyArtifacts |

# Merge + emit. split_doc consumes each element as a separate yaml doc.
$authArtifacts + $keyArtifacts
| .[]
| select(.content != null and .content != "")
| split_doc
