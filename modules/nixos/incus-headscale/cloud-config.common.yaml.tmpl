#cloud-config
# Common Headscale Cloud-init Configuration
# Shared setup for both server and gateway instances

packages:
  - curl
  - jq

write_files:
  # Helper script to load environment variables from init process
  - path: /usr/local/sbin/load-incus-env
    permissions: "0755"
    content: |
      #!/bin/bash
      # Load environment variables from incus (set via incus config set environment.*)
      # These are available in /proc/1/environ (init process)
      eval "$(cat /proc/1/environ | tr '\0' '\n' | grep -E '^(HEADSCALE_|GATEWAY_)' | sed 's/^/export /')"

runcmd:
  # Install flox (same as RKE2 distrobuilder)
  - /bin/bash -c 'trap "rm -f /tmp/flox.deb" EXIT; curl -sL --fail -o /tmp/flox.deb https://downloads.flox.dev/by-env/stable/deb/flox-1.5.0.aarch64-linux.deb && apt-get install -y /tmp/flox.deb'
  - /bin/bash -c 'mkdir -p /etc/flox && echo "disable_metrics = true" > /etc/flox/config.toml'
