#cloud-config
# Headscale Server Configuration
# Deploys Headscale control plane for internal network SSH and VPN

hostname: headscale-server

packages:
  - sqlite3

write_files:
  # Headscale main configuration template
  - path: /etc/headscale/config.yaml.tmpl
    content: |
      server_url: ${HEADSCALE_SERVER_URL}
      listen_addr: 0.0.0.0:8080
      metrics_listen_addr: 127.0.0.1:9090
      
      grpc_listen_addr: 127.0.0.1:50443
      grpc_allow_insecure: false
      
      private_key_path: /var/lib/headscale/private.key
      noise:
        private_key_path: /var/lib/headscale/noise_private.key
      
      prefixes:
        v4: 100.64.0.0/10
        v6: fd7a:115c:a1e0::/48
      
      derp:
        server:
          enabled: false
        urls:
          - https://controlplane.tailscale.com/derpmap/default
        auto_update_enabled: true
        update_frequency: 24h
      
      disable_check_updates: true
      
      dns:
        override_local_dns: true
        nameservers:
          global:
            - 1.1.1.1
            - 1.0.0.1
        search_domains: []
        magic_dns: true
        base_domain: ${HEADSCALE_BASE_DOMAIN}
      
      database:
        type: sqlite3
        sqlite:
          path: /var/lib/headscale/db.sqlite
      
      policy:
        path: /etc/headscale/policy.json

  # Default ACL policy
  - path: /etc/headscale/policy.json
    content: |
      {
        "acls": [
          {
            "action": "accept",
            "src": ["*"],
            "dst": ["*:*"]
          }
        ],
        "groups": {
          "group:admin": [],
          "group:servers": [],
          "group:clients": [],
          "group:gateways": []
        },
        "tagOwners": {
          "tag:server": ["group:admin"],
          "tag:client": ["group:admin"],
          "tag:gateway": ["group:admin"]
        }
      }

  # Headscale systemd service
  - path: /etc/systemd/system/headscale.service
    content: |
      [Unit]
      Description=Headscale Control Server
      After=network-online.target
      Wants=network-online.target
      
      [Service]
      Type=notify
      ExecStart=/usr/bin/headscale serve
      Restart=always
      RestartSec=5
      
      # Hardening
      NoNewPrivileges=true
      PrivateTmp=true
      ProtectSystem=strict
      ProtectHome=true
      ReadWritePaths=/var/lib/headscale /var/run/headscale /.shared.d
      RuntimeDirectory=headscale
      
      [Install]
      WantedBy=multi-user.target
  
  # Headscale bootstrap service (runs once after headscale is ready)
  - path: /etc/systemd/system/headscale-bootstrap.service
    content: |
      [Unit]
      Description=Bootstrap Headscale (create admin user and preauth key)
      After=headscale.service
      Requires=headscale.service
      
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/bin/headscale-bootstrap.sh
      
      [Install]
      WantedBy=multi-user.target
  
  # Bootstrap script
  - path: /usr/local/bin/headscale-bootstrap.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -e
      
      echo "Waiting for Headscale to be ready..."
      # Wait for gRPC socket
      timeout 30 bash -c 'until [ -S /var/run/headscale/headscale.sock ]; do sleep 1; done'
      
      echo "Creating admin user..."
      /usr/bin/headscale users create admin || echo "User admin already exists"
      
      echo "Creating preauth key..."
      /usr/bin/headscale preauthkeys create --user admin --reusable --expiration 720h | \
        tee /.shared.d/admin-preauth-key.txt
      chmod 644 /.shared.d/admin-preauth-key.txt
      
      echo "Bootstrap complete!"

runcmd:
  # Initialize flox environment for headscale
  - /bin/bash -c 'if [ ! -d /var/lib/headscale/.flox ]; then flox init --dir=/var/lib/headscale; fi'
  - /bin/bash -c 'flox install --dir=/var/lib/headscale yq-go'
  
  # Create headscale user and directories
  - useradd -r -s /bin/false headscale || true
  - mkdir -p /var/lib/headscale /etc/headscale
  - chown -R headscale:headscale /var/lib/headscale
  
  # Process config template with environment variables using flox
  - /bin/bash -c 'source /usr/local/sbin/load-incus-env && source <(flox activate --dir=/var/lib/headscale) && yq eval "( ... | select( tag == \"!!str\" ) ) |= envsubst" /etc/headscale/config.yaml.tmpl > /etc/headscale/config.yaml && rm -f /etc/headscale/config.yaml.tmpl'
  
  # Download and install Headscale (latest version)
  - |
    ARCH="arm64"
    cd /tmp
    HEADSCALE_VERSION=$(curl -sL https://api.github.com/repos/juanfont/headscale/releases/latest | jq -r '.tag_name' | sed 's/^v//')
    echo "Installing Headscale version ${HEADSCALE_VERSION}"
    curl -fsSL "https://github.com/juanfont/headscale/releases/download/v${HEADSCALE_VERSION}/headscale_${HEADSCALE_VERSION}_linux_${ARCH}.deb" -o headscale.deb
    apt-get install -y ./headscale.deb
    rm headscale.deb
  
  # Enable and start services
  - systemctl daemon-reload
  - systemctl enable headscale headscale-bootstrap
  - systemctl start headscale headscale-bootstrap

final_message: |
  Headscale server is ready!
  
  Server URL: ${HEADSCALE_SERVER_URL}
  Network: 100.64.0.0/10
  Default user: admin
  
  Preauth key location (in container): /.shared.d/admin-preauth-key.txt
  Preauth key location (on host): .run.d/incus/headscale-server/shared/admin-preauth-key.txt
  
  Retrieve preauth key:
    make preauth-key
    or: cat .run.d/incus/headscale-server/shared/admin-preauth-key.txt
  
  Management commands:
    headscale users list
    headscale nodes list
    headscale routes list
    headscale preauthkeys list --user admin
