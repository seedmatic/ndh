{
  config,
  lib,
  ndh,
  pkgs,
  self,
  ...
}:
# Platform-agnostic nix-store identity options.
#
# Data layer: the `nix-store` entry in keys.yaml produces a rotating
# keypair signed by mammoth-skate. The enrich+extract pipeline writes
# the usable material under the NDH-managed system-keys root:
#   ${sshPaths.systemKeysDir}/nix-store            (private, 0600)
#   ${sshPaths.systemKeysDir}/nix-store-cert.pub   (symlink → user cert)
#
# Consumers (the `nix-store.<peer>` ssh alias, `nix copy --to`
# from bioskop during remote bringup activation) read those paths
# directly — there is no /etc/nix/ copy. The ssh
# alias is the single source of truth for nix-store outbound auth; any
# new consumer should go through `ssh-ng://nix-store.<host>` and let
# the alias supply IdentityFile + CertificateFile.
#
# The inbound account is declared here once (name, own group, description, home); the platform modules add only
# their idiom: numeric ids, the shell as a store path and the directory-services heal on Darwin (a shell package
# would render as /run/current-system/sw/…), a system user and the shell as a package on NixOS.
#
#   - modules/darwin/nix-store-identity.nix
#   - modules/nixos/nix-store-identity.nix
let
  cfg = config.nixStoreIdentity;

  ndhContext = lib.attrByPath [ "context" ] { } ndh;
  inventoryHostNames = builtins.attrNames (lib.attrByPath [ "inventory" "hosts" ] { } ndhContext);
  selfHostName = config.networking.hostName or "";
  # Never this host itself: a build sent to its own store waits forever on the output locks it already holds.
  tailnetDomain = lib.attrByPath [ "catalog" "netplan" "tailnet" "domain" ] "" ndhContext;
  peerHostNames = lib.optionals cfg.outbound (
    lib.filter (h: h != selfHostName && h != "") (lib.unique (inventoryHostNames ++ cfg.extraPeers))
  );

  # Restricted login shell for the inbound nix-daemon user. Rendered as a
  # writeShellApplication so the file is 0555 and shellcheck-clean; the
  # passthru.shellPath override is mandatory for NixOS's users-groups
  # validator to accept the package as a login shell.
  #
  # Using a store-path shell (rather than /etc/ssh/nix-store-shell)
  # sidesteps Darwin's /etc permission surface — nix-darwin's
  # environment.etc does not honour `mode`, and the /etc/static/<…>
  # symlink chain it materializes points at a 0444 store file, which
  # sshd rejects with "shell is not executable".
  # The one command this account runs, as its shell and as sshd's ForceCommand (opensshPolicy.restrictedUsers):
  # the shell alone would leave a client's forwardings and subsystems to sshd.
  daemonCommand = lib.concatStringsSep " " (
    [ "/run/current-system/sw/bin/nix-daemon --stdio" ] ++ map lib.escapeShellArg cfg.inboundDaemonArgs
  );
  inboundUserShell =
    (pkgs.writeShellApplication {
      name = "nix-store-shell";
      text = ''
        exec ${daemonCommand}
      '';
    }).overrideAttrs
      (_: {
        passthru.shellPath = "/bin/nix-store-shell";
        meta.shellPath = "/bin/nix-store-shell";
      });

  # Per-host stanza. CertificateFile is mandatory: with cert-signed auth,
  # ssh must present the cert alongside the private or sshd will not
  # match the TrustedUserCAKeys / AuthorizedPrincipalsCommand pair.
  # The timeouts make a cut route fail in seconds: nix gives ssh none, and a build would wait on the TCP timeout.
  peerStanza = host: ''
    Host nix-store.${host}
      HostName ${host}${if lib.elem host cfg.tailnetPeers then tailnetDomain else cfg.hostSuffix}
      ConnectTimeout 5
      ServerAliveInterval 15
      ServerAliveCountMax 4
      User nix-store
      IdentityFile ${cfg.keyPath}
      CertificateFile ${cfg.certPath}
      IdentitiesOnly yes
      AddKeysToAgent no
  '';

  sshClientFragmentText =
    "# Generated by modules/.common.d/nix-store-identity.nix (@codebase)\n"
    + lib.concatMapStringsSep "\n" peerStanza peerHostNames;
in
{
  imports = [ ./ssh-paths.nix ];

  options.nixStoreIdentity = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Whether to expose the nix-store identity deploy helpers on this host.";
    };

    keyPath = lib.mkOption {
      type = lib.types.str;
      default = "${config.sshPaths.systemKeysDir}/nix-store";
      description = ''
        Path to the nix-store private key. Written directly by the
        ssh-keys enrich/extract pipeline under sshPaths.systemKeysDir —
        no separate deploy step. Bound as IdentityFile in the
        `nix-store.<peer>` ssh alias.
      '';
    };

    certPath = lib.mkOption {
      type = lib.types.str;
      default = "${config.sshPaths.systemKeysDir}/nix-store-cert.pub";
      description = ''
        Path to the nix-store user certificate. Written as a symlink by
        the ssh-keys enrich/extract pipeline. Bound as CertificateFile
        in the `nix-store.<peer>` ssh alias; ssh-client follows symlinks.
      '';
    };

    provisionInboundUser = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Provision a local `nix-store` system user that serves inbound
        `nix-daemon --stdio` connections, register it as a trusted nix
        user, and expose its login shell.
      '';
    };

    inboundUserName = lib.mkOption {
      type = lib.types.str;
      default = "nix-store";
      description = "Login name of the inbound nix-daemon user.";
    };

    inboundUserUid = lib.mkOption {
      type = lib.types.int;
      default = 630;
      description = ''
        POSIX UID for the inbound nix-daemon user. Darwin needs an
        explicit UID in users.knownUsers; NixOS ignores this field and
        auto-allocates instead.
      '';
    };

    inboundUserHome = lib.mkOption {
      type = lib.types.str;
      default = "/var/empty";
      description = ''
        Home directory declared for the inbound nix-daemon user — normally
        /var/empty (a service account with no real home).

        Overridable per-host because macOS 26.5's directory-services
        consistency pass can rewrite the record's NFSHomeDirectory to a
        spurious /private/var/empty_1 AND then lock the record against writes
        even by root — dscl and sysadminctl both fail with eDSPermissionError,
        so the rewrite cannot be undone. When that happens the only way past
        nix-darwin's home-directory check is to STOP fighting it and declare
        the home the record is stuck on. The darwin heal target follows this
        option too, so a matching value makes the heal a no-op (no dscl write).
        See modules/darwin/nix-store-identity.nix.
      '';
    };

    inboundUserShellPackage = lib.mkOption {
      type = lib.types.package;
      default = inboundUserShell;
      description = ''
        Package providing the restricted login shell for the inbound
        nix-daemon user. Carries `meta.shellPath` + `passthru.shellPath`
        so NixOS's users-groups validator accepts it.
      '';
    };

    inboundUserShellPath = lib.mkOption {
      type = lib.types.str;
      default = "${cfg.inboundUserShellPackage}${cfg.inboundUserShellPackage.shellPath}";
      description = "Absolute path to the inbound user's login shell inside its store package.";
    };

    extraPeers = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      description = ''
        Machines outside the inventory's hosts that also get a `nix-store.<peer>`
        alias: the NixOS guest a Darwin host builds on (modules/darwin/host-builder.nix).
      '';
    };

    outbound = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Whether this host sends requests as nix-store: its `nix-store.<peer>` aliases. Off on the builders that only
        receive (the NixOS guests): a build they receive cannot be forwarded, so it cannot come back to a store that
        holds its output locks.
      '';
    };

    tailnetPeers = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      description = "Peers in another metalspace: their alias reaches `<peer><tailnet domain>` instead of `<peer><hostSuffix>`.";
    };

    inboundDaemonArgs = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      description = "Extra arguments of the inbound `nix-daemon --stdio`, the account's shell and sshd's ForceCommand alike.";
    };

    inboundTrusted = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Whether the inbound account is a trusted nix user. Off where it is served untrusted (inboundDaemonArgs'
        --force-untrusted): that flag guards only the connections through the ForceCommand, and any other way to
        reach the daemon as this account would still be root to it.
      '';
    };

    hostSuffix = lib.mkOption {
      type = lib.types.str;
      default = ".local";
      description = "Suffix appended to each inventory hostname when building the reachable HostName.";
    };

    sshClientFragment = lib.mkOption {
      type = lib.types.str;
      readOnly = true;
      description = "Rendered /etc/ssh/ssh_config.d fragment exposing Host nix-store.<peer> aliases.";
    };
  };

  config = lib.mkIf cfg.enable {
    nixStoreIdentity.sshClientFragment = sshClientFragmentText;
    opensshPolicy.fleetHostAliases = map (host: "nix-store.${host}") (
      lib.filter (host: lib.elem "${host}${cfg.hostSuffix}" self.fleetHostNames) peerHostNames
    );

    environment.etc."ssh/ssh_config.d/75-nix-store.conf" = lib.mkIf (peerHostNames != [ ]) {
      text = sshClientFragmentText;
    };

    # Its own group, never the build-users-group: the nix daemon refuses a client whose primary group is
    # build-users-group, trusted or not (nix 2.34 daemon.cc, authPeer).
    users.groups = lib.mkIf cfg.provisionInboundUser { ${cfg.inboundUserName} = { }; };
    users.users = lib.mkIf cfg.provisionInboundUser {
      ${cfg.inboundUserName} = {
        description = "Inbound nix-daemon --stdio endpoint";
        home = cfg.inboundUserHome;
      };
    };

    environment.shells = lib.mkIf cfg.provisionInboundUser [ cfg.inboundUserShellPath ];
    nix.settings.trusted-users = lib.mkIf (cfg.provisionInboundUser && cfg.inboundTrusted) [
      cfg.inboundUserName
    ];
    opensshPolicy.restrictedUsers = lib.mkIf cfg.provisionInboundUser {
      ${cfg.inboundUserName}.forceCommand = daemonCommand;
    };
  };
}
