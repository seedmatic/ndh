.DS_STORE
.vscode/
# Claude Code's own per-checkout files: nothing under .claude/ is tracked
/.claude/
**/result
.git/
.git.clone.d/
.devenv/
.pre-commit-config.yaml
nixos.qcow2
# bootstrap-linux-builder / stock create-builder artifacts if run from the repo
# (the app writes these under $XDG_STATE_HOME instead; these guard stray runs)
keys/
store-*.img
vzvm.json
console.log
.run.d
tmp/
.zsh_history.copilot.hidden
sandbox/zfs-raidz1-lab/.tart
# Operator's local re-aim of the flake-input registry. REPLACES the committed
# flake-registry.json when present (see the [hook] in .flox/env/manifest.toml).
# Ignored rather than tracked so a local re-aim never reads as a dirty tree to
# relock's guard rail — which is also why it cannot simply be `git add -f`'ed:
# .gitignore stops protecting a file the moment it is tracked.
flake-registry.local.json
