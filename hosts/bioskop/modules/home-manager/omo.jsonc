{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "agents": {
    "explore": {
      "model": "litellm-bioskop/agent",
      "max_turns": 40,
      "tools": {
        "write": false,
        "edit": false,
        "apply_patch": false,
        "bash": false
      }
    },
    "librarian": {
      "model": "litellm-bioskop/agent",
      "max_turns": 40,
      "tools": {
        "write": false,
        "edit": false,
        "apply_patch": false,
        "bash": false
      }
    },
    "code-reviewer": {
      "model": "litellm-bioskop/agent",
      "max_turns": 40,
      "tools": {
        "write": false,
        "edit": false,
        "apply_patch": false
      }
    }
  },
  "categories": {
    "quick": {
      "model": "litellm-bioskop/agent",
      "textVerbosity": "low",
      "reasoning": "off"
    },
    "deep-low": {
      "model": "litellm-bioskop/agent-deep",
      "textVerbosity": "low",
      "reasoning": "medium"
    },
    "deep-high": {
      "model": "litellm-bioskop/agent-deep",
      "textVerbosity": "low",
      "reasoning": "medium"
    },
    "ultrabrain": {
      "model": "litellm-bioskop/agent-deep",
      "textVerbosity": "low",
      "reasoning": "high"
    },
    "unspecified-low": {
      "model": "litellm-bioskop/agent",
      "textVerbosity": "low",
      "reasoning": "off"
    },
    "unspecified-high": {
      "model": "litellm-bioskop/agent",
      "textVerbosity": "low",
      "reasoning": "off"
    },
    "writing": {
      "model": "litellm-bioskop/agent",
      "textVerbosity": "low",
      "reasoning": "off"
    },
    "visual-engineering": {
      "model": "litellm-bioskop/agent",
      "textVerbosity": "low",
      "reasoning": "off"
    },
    "artistry": {
      "model": "litellm-bioskop/agent",
      "textVerbosity": "low",
      "reasoning": "off"
    },
    "architect": {
      "model": "litellm-bioskop/agent-deep",
      "textVerbosity": "low",
      "reasoning": "medium"
    }
  },
  "task": {
    "default_concurrency": 1,
    "provider_concurrency": {
      "litellm-bioskop": 2
    },
    "dag": {
      "max_prompt_bytes": 131072
    }
  },
  "memory": {
    "enabled": true,
    "recall": {
      "category": "quick",
      "max_items": 1,
      "tool_budget": 4,
      "sidecar_max_tokens": 24000,
      "event_caps": {
        "tool_args": 200,
        "result_head": 300,
        "assistant": 800,
        "prompt": 2000
      },
      "query_expansion": false
    },
    "facts": {
      "enabled": true,
      "debounce_settles": 6,
      "model": "litellm-bioskop/agent"
    },
    "nudge": {
      "enabled": true,
      "every_user_turns": 20
    },
    "reflection": {
      "enabled": true,
      "trigger": {
        "step_count": 25,
        "on_compaction": true
      }
    },
    "dream": {
      "enabled": false,
      "idle_minutes": 60,
      "min_hours_between": 48
    }
  },
  "disabled_skills": [
    "caveman",
    "caveman-compress",
    "caveman-review",
    "caveman-commit",
    "caveman-help",
    "hyperplan",
    "mass-ulw",
    "ulw-loop",
    "ulw-plan",
    "ulw-execute",
    "ulw-research",
    "ultimate-browsing",
    "computer-use",
    "visualize",
    "visual-qa",
    "init-deep",
    "onboarding",
    "skill-miner",
    "skill-generalizer",
    "skill-personalizer",
    "package-npm-nix",
    "scaffold-exercises",
    "migrate-to-shoehorn",
    "setup-pre-commit",
    "git-guardrails-claude-code",
    "wizard",
    "dag-library",
    "eval-integrity",
    "codebase-design",
    "domain-modeling",
    "prototype",
    "give-me-tips",
    "writing-for-agents",
    "research",
    "data-scientist",
    "pr"
  ],
  "_migrations": [
    "2026-08-reasoning-unification",
    "2026-09-category-deep-split",
    "2026-09-harness-native-rename",
    "2026-09-subscription-provider-rename"
  ],
