%everyone ALL=(root:wheel) NOPASSWD:NOSETENV: /bin/mkdir -m 775 -p /private/var/run/lima

# Manage "bond0-bridged" network daemons

%everyone ALL=(root:wheel) NOPASSWD:NOSETENV: \
    /opt/socket_vmnet/bin/socket_vmnet --pidfile=/private/var/run/lima/bond0-bridged_socket_vmnet.pid --socket-group=everyone --vmnet-mode=bridged --vmnet-interface=bond0 /private/var/run/lima/socket_vmnet.bond0-bridged, \
    /usr/bin/pkill -F /private/var/run/lima/bond0-bridged_socket_vmnet.pid
